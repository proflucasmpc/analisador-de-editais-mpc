# Crie gratuitamente no Google AI Studio.
GEMINI_API_KEY=cole_a_chave_aqui

# Modelo gratuito padrão em agosto de 2026.
GEMINI_MODEL=gemini-2.5-flash

# Senha longa para acessar /admin.html e baixar os PDFs.
ADMIN_SECRET=crie_uma_senha_longa_e_unica

# Troque por uma sequência aleatória. Usada apenas para anonimizar IPs no limite diário.
RATE_LIMIT_SALT=troque_por_uma_frase_aleatoria_grande

# Limites de proteção da cota gratuita.
DAILY_ANALYSES_PER_IP=2
MAX_GEMINI_CALLS_PER_ANALYSIS=26
